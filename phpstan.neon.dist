includes:
    - phar://phpstan.phar/conf/bleedingEdge.neon
    - phpstan-baseline.neon

parameters:
    level: 10
    paths:
        - bin/build
        - src
        - tests
    ignoreErrors:
        - path: tests/*
          identifiers:
            - classConstant.internalClass
            - method.internalClass
            - new.internalClass
            - property.internalClass
