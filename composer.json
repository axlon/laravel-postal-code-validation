{
    "name": "axlon/laravel-postal-code-validation",
    "description": "Worldwide postal code validation for Laravel",
    "keywords": [
        "laravel",
        "post code",
        "postal code",
        "zip code",
        "validation"
    ],
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Choraimy Kroonstuiver",
            "homepage": "https://github.com/axlon"
        }
    ],
    "require": {
        "php": ">=8.2",
        "illuminate/contracts": "^12.0 || ^13.0",
        "illuminate/support": "^12.0 || ^13.0",
        "illuminate/validation": "^12.0 || ^13.0"
    },
    "require-dev": {
        "guzzlehttp/guzzle": "^7.8",
        "orchestra/testbench": "^10.0 || ^11.0",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^2.3",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-phpunit": "^2.1",
        "phpstan/phpstan-strict-rules": "^2.1",
        "phpunit/phpunit": "^11.5 || ^12.5 || ^13.4",
        "slevomat/coding-standard": "^8.25",
        "squizlabs/php_codesniffer": "^4.0",
        "symfony/var-exporter": "^4.0 || ^5.0 || ^6.0 || ^7.0"
    },
    "autoload": {
        "psr-4": {
            "Axlon\\PostalCodeValidation\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Axlon\\PostalCodeValidation\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "phpstan/extension-installer": true
        },
        "sort-packages": true
    },
    "scripts": {
        "build": "@php bin/build"
    },
    "extra": {
        "laravel": {
            "providers": [
                "\\Axlon\\PostalCodeValidation\\ValidationServiceProvider"
            ]
        }
    }
}
